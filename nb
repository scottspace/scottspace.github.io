#!/bin/bash
# Generate an image using fal.ai Nano Banana Pro
# Usage: ./generate.sh "your prompt here" [output.png] [aspect_ratio]
#   aspect_ratio: 1:1, 16:9, 9:16, 4:3, 3:4 (default: 16:9)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"

if [ ! -f "$ENV_FILE" ]; then
  echo "Error: .env file not found at $ENV_FILE"
  exit 1
fi

FAL_KEY=$(grep '^FAL_KEY=' "$ENV_FILE" | cut -d= -f2-)

if [ -z "$FAL_KEY" ]; then
  echo "Error: FAL_KEY not found in .env"
  exit 1
fi

PROMPT="${1:?Usage: ./generate.sh \"prompt\" [output.png] [aspect_ratio]}"
OUTPUT="${2:-generated_$(date +%s).png}"
ASPECT="${3:-16:9}"

echo "Submitting: $PROMPT"
echo "Aspect: $ASPECT"

RESPONSE=$(curl -s -X POST "https://queue.fal.run/fal-ai/nano-banana-pro" \
  -H "Authorization: Key $FAL_KEY" \
  -H "Content-Type: application/json" \
  -d "$(jq -n \
    --arg prompt "$PROMPT" \
    --arg aspect "$ASPECT" \
    '{prompt: $prompt, num_images: 1, aspect_ratio: $aspect, resolution: "2K", output_format: "png"}')")

REQUEST_ID=$(echo "$RESPONSE" | jq -r '.request_id // empty')

if [ -z "$REQUEST_ID" ]; then
  echo "Error submitting request:"
  echo "$RESPONSE" | jq .
  exit 1
fi

echo "Queued: $REQUEST_ID"

while true; do
  sleep 5
  RESULT=$(curl -s "https://queue.fal.run/fal-ai/nano-banana-pro/requests/$REQUEST_ID" \
    -H "Authorization: Key $FAL_KEY")

  URL=$(echo "$RESULT" | jq -r '.images[0].url // empty')

  if [ -n "$URL" ]; then
    echo "Downloading..."
    curl -s -o "$OUTPUT" "$URL"
    echo "Saved: $OUTPUT"
    exit 0
  fi

  DETAIL=$(echo "$RESULT" | jq -r '.detail // empty')
  if echo "$DETAIL" | grep -qi "error\|fail"; then
    echo "Error: $DETAIL"
    exit 1
  fi

  echo "Waiting..."
done
